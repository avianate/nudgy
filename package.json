{
  "name": "nudgy",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NUDGY_HOME=./.nudgy-dev bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "build": "bun scripts/build.ts",
    "install:local": "bun scripts/build.ts && bun scripts/installLocal.ts",
    "coverage:core": "bun scripts/coverageCore.ts",
    "test:bin": "bun scripts/build.ts && NUDGY_E2E_BIN=dist/nudgy bun test test/cli"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5",
    "@types/bun": "^1.4.2",
    "@types/react": "^19",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opentui/core": "0.5.12",
    "@opentui/react": "0.5.12",
    "chrono-node": "^2.10",
    "react": "^19.2"
  }
}
